# Provider credentials for the auditing agent.
# Copy this file to .env and fill in real values. Never commit .env.

# Required. Key for an OpenAI-compatible endpoint.
LLM_API_KEY=your-api-key-here

# Optional for OpenAI; required for hosted alternatives and local servers.
# Examples:
#   https://generativelanguage.googleapis.com/v1beta/openai/   (Google Gemini)
#   https://openrouter.ai/api/v1                               (OpenRouter)
#   https://api.groq.com/openai/v1                             (Groq)
#   http://localhost:11434/v1                                  (Ollama)
LLM_BASE_URL=

# Required. Model that supports tool/function calling.
# Examples: gpt-4o-mini, gemini-2.5-flash, llama-3.3-70b-versatile
LLM_MODEL=gpt-4o-mini

# Optional. Upper bound on agent steps (default 30).
MAX_STEPS=30

# Optional. Total wall-clock limit in seconds (default 600). When reached the
# agent stops investigating and submits the findings it has already proven.
AGENT_TIME_LIMIT_SECONDS=600

# Optional. Request timeout in seconds (default 120).
LLM_TIMEOUT=120
